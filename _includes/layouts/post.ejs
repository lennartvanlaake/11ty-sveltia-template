---
layout: layouts/base.ejs
section: post
---
<%#
  Post layout contract:
  - Required front matter: title, date, author.
  - Optional front matter: summary, image, imageAltText.
  - `content` is the rendered Markdown body.
  - Author and date helpers live in _data/helpers.js.
-%>
<article>
  <h1><%= title %></h1>

  <% if (locals.summary) { %>
    <p><%= locals.summary %></p>
  <% } %>

  <p>
    <small>
      Posted on
      <time datetime="<%= helpers.machineDate(page.date) %>">
        <%= helpers.readableDate(page.date) %>
      </time>
      <% if (locals.author) { %>
        by <a href="/authors/<%= helpers.slug(locals.author) %>/"><%= locals.author %></a>
      <% } %>
    </small>
  </p>

  <% if (locals.image) { %>
    <img
      src="<%= locals.image %>"
      alt="<%= locals.imageAltText || locals.title %>"
      loading="lazy"
      decoding="async">
  <% } %>

  <%- content %>
</article>

<%- include('../components/nav-back', { backUrl: "/posts/", backTitle: "Blog" }) %>
