<%#
  Base layout contract:
  - `content` is the rendered child layout or Markdown body.
  - `settings` comes from _data/settings.yml.
  - `section` is an optional front matter value used for page-specific CSS.
  - Keep this file structural; page-specific markup belongs in child layouts.
-%>
<!doctype html>
<html lang="en"<% if (locals.section) { %> data-current="<%= locals.section %>"<% } %>>
  <head>
    <%- include('../components/head') %>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header>
      <em><a href="/"><%= settings.title %></a></em>
      <%- include('../components/nav') %>
    </header>

    <main id="main">
      <%- content %>
    </main>

    <%- include('../components/footer') %>
  </body>
</html>
