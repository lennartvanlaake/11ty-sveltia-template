<%#
  Post list contract:
  - Expects `postsList`: an array of Eleventy collection items.
  - Pass it explicitly: include('../components/post-list', { postsList: ... })
  - Renders newest first.
-%>
<% const posts = locals.postsList || []; %>

<% if (posts.length > 0) { %>
  <p><%= posts.length %> <%= posts.length === 1 ? "post" : "posts" %></p>
<% } %>

<section>
  <% for (const post of [...posts].reverse()) { %>
    <article>
      <a href="<%= post.url %>">
        <% if (post.data.image) { %>
          <img
            src="<%= post.data.image %>"
            alt="<%= post.data.imageAltText || post.data.title %>"
            loading="lazy"
            decoding="async">
        <% } %>
        <h3><%= post.data.title %></h3>
      </a>

      <time datetime="<%= helpers.machineDate(post.date) %>">
        <small>
          <%= helpers.readableDate(post.date) %>
          <% if (post.data.author) { %>
            by <a href="/authors/<%= helpers.slug(post.data.author) %>/"><%= post.data.author %></a>
          <% } %>
        </small>
      </time>
    </article>
  <% } %>
</section>
