<%#
  Main navigation contract:
  - Reads the flat `collections.nav` collection from eleventy.config.js.
  - Pages opt in with `eleventyNavigation` front matter.
  - `order` controls display order; lower numbers come first.
-%>
<nav aria-label="Main">
  <ul>
    <% for (const entry of collections.nav) { %>
      <li>
        <a href="<%= entry.url %>"<% if (entry.url === page.url) { %> aria-current="page"<% } %>><%= entry.data.eleventyNavigation.title %></a>
      </li>
    <% } %>
  </ul>
</nav>
