---
title: Authors
description: All authors.
layout: layouts/base.ejs
eleventyNavigation:
  key: authors
  title: Authors
  order: 3
permalink: /authors/index.html
---
<%#
  Author index.
  - `collections.author` comes from the internal tag in authors/authors.11tydata.js.
  - Each author's own URL is set in authors/authors.11tydata.js.
-%>
<h1><%= title %></h1>

<section>
  <% for (const author of collections.author) { %>
    <article>
      <a href="<%= author.url %>">
        <% if (author.data.image) { %>
          <img
            src="<%= author.data.image %>"
            alt="<%= author.data.name %>"
            loading="lazy"
            decoding="async">
        <% } %>
        <h3><%= author.data.name %></h3>
      </a>
    </article>
  <% } %>
</section>
